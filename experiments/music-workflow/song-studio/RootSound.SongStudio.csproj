<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>RootSound.SongStudio</AssemblyName><RootNamespace>RootSound.SongStudio</RootNamespace>
    <PlatformTarget>x64</PlatformTarget><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" /><Compile Remove="Launcher/**/*.cs" />
    <Compile Include="../sample-editor/Playback/**/*.cs" Link="SharedPlayback/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../sample-editor/Core/IAudioFrameSource.cs" Link="Shared/IAudioFrameSource.cs" />
    <Compile Include="../timbre-lab/Core/Models.cs" Link="Shared/Models.cs" />
    <Compile Include="../timbre-lab/Instrument/InstrumentValidation.cs" Link="Shared/InstrumentValidation.cs" />
    <Compile Include="../phrase-studio/Core/PhraseModels.cs" Link="Shared/PhraseModels.cs" />
    <Compile Include="../phrase-studio/Persistence/DocumentFormat.cs" Link="Shared/PhraseFormat.cs" />
    <Compile Include="../phrase-studio/Persistence/PhraseArchive.cs" Link="Shared/PhraseArchive.cs" />
    <Compile Include="../phrase-studio/Audio/InstrumentVoice.cs" Link="Shared/InstrumentVoice.cs" />
    <InternalsVisibleTo Include="RootSound.SongStudio.Tests" />
  </ItemGroup>
</Project>
