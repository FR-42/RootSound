<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RootSound.TimbreLab</AssemblyName>
    <RootNamespace>RootSound.TimbreLab</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="Launcher/**/*.cs" />
    <Compile Include="../sample-editor/Audio/**/*.cs" Link="SharedAudio/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../sample-editor/Playback/**/*.cs" Link="SharedPlayback/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../sample-editor/Core/IAudioFrameSource.cs" Link="SharedAudio/IAudioFrameSource.cs" />
    <Compile Include="../sample-editor/Core/Timeline.cs" Link="SharedAudio/Timeline.cs" />
    <InternalsVisibleTo Include="RootSound.TimbreLab.Tests" />
  </ItemGroup>
</Project>
