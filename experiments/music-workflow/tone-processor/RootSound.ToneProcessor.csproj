<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <Compile Remove="tests/**/*.cs;Launcher/**/*.cs" />
    <Compile Include="../sample-editor/Audio/*.cs;../sample-editor/Core/*.cs;../sample-editor/Playback/*.cs;../sample-editor/Analysis/*.cs;../sample-editor/Controls/AudioPlot.cs" Link="Shared/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../spectral-forge/host/WebSecurity.cs" Link="Shared/WebSecurity.cs" />
    <Compile Include="../timbre-lab/MainForm.cs;../timbre-lab/Audio/*.cs;../timbre-lab/Controls/*.cs;../timbre-lab/Core/*.cs;../timbre-lab/Instrument/*.cs;../timbre-lab/Processing/*.cs" Link="TimbreLab/%(RecursiveDir)%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="RootSound.ToneProcessor.Tests" />
    <InternalsVisibleTo Include="RootSound.ToneStructure" />
    <InternalsVisibleTo Include="RootSound.ToneStructure.Tests" />
    <Content Include="web/**/*" Link="ui/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../spectral-forge/web/curve-editor.mjs;../spectral-forge/web/curve-density.mjs;../spectral-forge/web/model.mjs;../spectral-forge/web/dsp.mjs;../spectral-forge/web/styles.css" Link="ui/shared/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ExcludeUnusedWebViewWpfAssembly" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup><Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" /></ItemGroup>
  </Target>
</Project>
